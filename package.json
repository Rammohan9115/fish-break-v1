{
  "name": "fishbowl-break",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:assets": "vite-node scripts/build-assets.ts",
    "build:icons": "vite-node scripts/build-icons.ts",
    "lint": "eslint .",
    "test:e2e": "playwright test -c playwright.config.cjs",
    "trailer": "tsx scripts/trailer/audio.ts trailer/audio && tsx scripts/trailer/record.ts && bash scripts/trailer/edit.sh",
    "trailer:record": "tsx scripts/trailer/record.ts",
    "trailer:edit": "bash scripts/trailer/edit.sh"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.49",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "sharp": "^0.33.5",
    "tsx": "^4.23.15",
    "typescript": "~5.6",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
